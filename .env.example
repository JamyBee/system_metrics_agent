# Adresse de l'API qui recoit les metriques
# En local (sans Docker) :
METRICS_ENDPOINT=http://127.0.0.1:8000/metrics
# Avec Docker Compose, cette valeur est remplacee par http://api:8000/metrics

# Intervalle de collecte, en secondes
COLLECTION_INTERVAL=5

# Delai maximum d'une requete HTTP, en secondes
REQUEST_TIMEOUT=5