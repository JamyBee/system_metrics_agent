# ===== Etape 1 : builder (installe les dependances) =====
FROM python:3.12-slim-bookworm AS builder

WORKDIR /build
COPY requirements-agent.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements-agent.txt

# ===== Etape 2 : image finale =====
FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# procps fournit la commande "uptime" utilisee par le collecteur
RUN apt-get update \
    && apt-get install -y --no-install-recommends procps \
    && rm -rf /var/lib/apt/lists/*

# Utilisateur non-root
RUN useradd --create-home --uid 10001 appuser

WORKDIR /app
COPY --from=builder /install /usr/local
COPY app/ ./app/

USER appuser

CMD ["python", "-m", "app.agent"]